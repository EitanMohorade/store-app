# ── Store App — Variables de entorno ──────────────────
# Copiá este archivo como .env y completá los valores.
# El archivo .env NUNCA se sube al repositorio.

# URL base del backend (sin /api al final).
# En desarrollo el proxy de Vite lo maneja automáticamente,
# pero en producción necesitás apuntar al servidor real.
VITE_API_BASE_URL=http://localhost:8080
